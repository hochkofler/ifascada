{
  "connections": [
    {
      "id": "conn_scale_mock_inline_1",
      "name": "Scale Mock Inline",
      "driver_type": "SerialAscii",
      "timeout_ms": 200,
      "reconnect_delay_ms": 1000,
      "max_retries": null,
      "transport": {
        "mock": {
          "enabled": true,
          "interval_ms": 400,
          "frames": [
            "+ 12.4354 g",
            "+ 12.5354 g",
            "+ 12.6354 g",
            "- 0.0150 g"
          ]
        },
        "frame": {
          "mode": "line",
          "terminator": "\r\n",
          "max_len": 128
        },
        "parser": {
          "regex": "^\\s*([+-])?\\s*(\\d+(?:\\.\\d+)?)\\s*([A-Za-z]+)\\s*$",
          "sign_group": 1,
          "value_group": 2,
          "unit_group": 3
        },
        "tag_map": {
          "tag_scale_compound": "scale:compound",
          "tag_scale_raw": "scale:raw"
        }
      },
      "tags": [
        {
          "id": "tag_scale_compound",
          "name": "Scale Compound",
          "device_id": "dev_scale_mock_1",
          "source": "scale:compound",
          "value_type": "string",
          "update_mode": "on_change"
        },
        {
          "id": "tag_scale_raw",
          "name": "Scale Raw",
          "device_id": "dev_scale_mock_1",
          "source": "scale:raw",
          "value_type": "string",
          "update_mode": "on_change"
        }
      ]
    }
  ]
}
