{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/max-lines-per-function": ["error", { "max": 150, "skipBlankLines": true, "skipComments": true, "IIFEs": true }]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**", "src/components/data-table/**"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": { "eslint/max-lines-per-function": "off" }
    }
  ]
}
